{
  "_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. The core is six machines and each takes its own kind of file, so each has its own slot. Choosing Game Gear offers Game Gear cartridges only, and the Sega CD is the machine that takes discs. Only the slot of the chosen machine is shown (the exposedWhen conditions do this). The machine comes from the project and never from a file name.",
  "slots": [
    {
      "id": "cart_md",
      "title": "common.cartridge",
      "min": 1,
      "max": 1,
      "formats": ["md", "gen", "bin", "smd", "mdx"],
      "help": "slot.cart_md.help",
      "exposedWhen": { "setting": "systemHardware", "is": "genesis" }
    },
    {
      "id": "cart_sms",
      "title": "common.cartridge",
      "min": 1,
      "max": 1,
      "formats": ["sms"],
      "help": "slot.cart_sms.help",
      "exposedWhen": { "setting": "systemHardware", "is": "sms" }
    },
    {
      "id": "cart_gg",
      "title": "common.cartridge",
      "min": 1,
      "max": 1,
      "formats": ["gg"],
      "help": "slot.cart_gg.help",
      "exposedWhen": { "setting": "systemHardware", "is": "gg" }
    },
    {
      "id": "cart_sg",
      "title": "common.cartridge",
      "min": 1,
      "max": 1,
      "formats": ["sg"],
      "help": "slot.cart_sg.help",
      "exposedWhen": { "setting": "systemHardware", "is": "sg" }
    },
    {
      "id": "cart_pico",
      "title": "common.cartridge",
      "min": 1,
      "max": 1,
      "formats": ["md", "bin", "gen"],
      "help": "slot.cart_pico.help",
      "exposedWhen": { "setting": "systemHardware", "is": "pico" }
    },
    {
      "id": "cd",
      "title": "slot.cd",
      "min": 1,
      "max": -1,
      "formats": ["cue", "iso", "bin"],
      "help": "slot.cd.help",
      "exposedWhen": { "setting": "systemHardware", "is": "segacd" }
    }
  ]
