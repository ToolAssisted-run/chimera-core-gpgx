  "settings": [
    {
      "name": "systemHardware",
      "display": "Console Hardware",
      "type": "enum",
      "options": [
        "genesis",
        "segacd",
        "sms",
        "gg",
        "sg"
      ],
      "default": "genesis",
      "description": "Which machine this project is: a Mega Drive, a Sega CD, a Master System, a Game Gear or an SG-1000. The choice is saved in the project and recorded in the movie, and the core never guesses it from a file name. The Sega CD takes discs. The others each take their own kind of cartridge."
    },
    {
      "name": "port1",
      "display": "Control Type - Left Port",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "What is plugged into the console's left controller port. Some games expect a particular device. Only gamepads (also through a multitap) work so far. The other devices are not supported yet."
    },
    {
      "name": "port2",
      "display": "Control Type - Right Port",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "What is plugged into the console's right controller port."
    },
    {
      "name": "useSixButton",
      "display": "Use Six Button Controllers",
      "type": "bool",
      "default": false,
      "description": "Uses six-button controllers instead of three-button ones for every ordinary gamepad. Some games do not work properly with six-button controllers.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "region",
      "display": "Region",
      "type": "enum",
      "options": [
        "autodetect",
        "usa",
        "europe",
        "japanNtsc",
        "japanPal"
      ],
      "default": "autodetect",
      "description": "The console's region. Many games run in several regions and behave differently in each, and some need one particular region."
    },
    {
      "name": "forceVDP",
      "display": "Force VDP Mode",
      "type": "enum",
      "options": [
        "disabled",
        "ntsc",
        "pal"
      ],
      "default": "disabled",
      "description": "Forces the video mode to 60 Hz (NTSC) or 50 Hz (PAL), whatever the console's region is."
    },
    {
      "name": "loadBios",
      "display": "Load BIOS",
      "type": "bool",
      "default": false,
      "description": "Starts the machine through its BIOS ROM first (on a Genesis this shows the TMSS start-up screen). It needs the matching firmware file.",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "genesis",
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "overscan",
      "display": "Overscan",
      "type": "enum",
      "options": [
        "none",
        "vertical",
        "horizontal",
        "all"
      ],
      "default": "none",
      "description": "Which of the picture's borders (overscan) are drawn."
    },
    {
      "name": "genesisFmSoundChip",
      "display": "Genesis FM Sound Chip",
      "type": "enum",
      "options": [
        "mameYM2612",
        "mameASICYM3438",
        "mameEnhancedYM3438",
        "nukedYM2612",
        "nukedYM3438"
      ],
      "default": "mameYM2612",
      "description": "How the FM sound chip of the Mega Drive / Genesis is emulated. The MAME choices are fast. The Nuked choices follow the chip's own timing exactly and need much more processing. YM2612 is the chip of the first console model and YM3438 the chip of later ones.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "smsFmSoundChip",
      "display": "SMS FM Sound Chip",
      "type": "enum",
      "options": [
        "mame",
        "disabled",
        "nuked"
      ],
      "default": "mame",
      "description": "How the FM Sound Unit of the Mark III / Master System is emulated. MAME is fast, Nuked is exact and needs much more processing, and the last choice leaves the FM unit out.",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "ggExtra",
      "display": "Game Gear Extended Screen",
      "type": "bool",
      "default": false,
      "description": "Shows the Game Gear's extended picture area (256x192).",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "gg"
      }
    },
    {
      "name": "filter",
      "display": "Audio Filter",
      "type": "enum",
      "options": [
        "lowPass",
        "none",
        "threeBand"
      ],
      "default": "lowPass",
      "description": "The filter applied to the sound output."
    },
    {
      "name": "lowPassRange",
      "display": "Low Pass Range",
      "type": "int",
      "default": 26214,
      "min": 0,
      "max": 65535,
      "description": "How strong the low-pass filter is, as a fraction of 65536 (26214 is 40%). It is used only when Audio Filter is lowPass."
    },
    {
      "name": "lowFreq",
      "display": "Three Band Low Cutoff",
      "type": "int",
      "default": 880,
      "description": "Used only when Audio Filter is threeBand."
    },
    {
      "name": "highFreq",
      "display": "Three Band High Cutoff",
      "type": "int",
      "default": 5000,
      "description": "Used only when Audio Filter is threeBand."
    },
    {
      "name": "lowGain",
      "display": "Three Band Low Gain",
      "type": "int",
      "default": 100,
      "description": "A percentage. Used only when Audio Filter is threeBand."
    },
    {
      "name": "midGain",
      "display": "Three Band Mid Gain",
      "type": "int",
      "default": 100,
      "description": "A percentage. Used only when Audio Filter is threeBand."
    },
    {
      "name": "highGain",
      "display": "Three Band High Gain",
      "type": "int",
      "default": 100,
      "description": "A percentage. Used only when Audio Filter is threeBand."
    },
    {
      "name": "spritesAlwaysOnTop",
      "display": "Sprites Always On Top",
      "type": "bool",
      "default": false,
      "description": "Always draws sprites in front of everything else.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "forceSram",
      "display": "Force SRAM Mapping",
      "type": "bool",
      "default": false,
      "description": "Gives a cartridge 64 KB of battery-backed save memory at address $200000 when it is smaller than 2 MB and its header declares none. A few games need this. BizHawk's version of this core decides it from its game database.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    }
  ],
  "firmware": [
    {
      "id": "cdBiosUS",
      "display": "Sega CD BIOS (USA)",
      "description": "The boot ROM of the USA Sega CD (128 KB). It is needed to run a USA disc. The Region setting says which region a project uses, and 'autodetect' allows all three.",
      "size": 131072,
      "sha1": "F4F315ADCEF9B8FEB0364C21AB7F0EAF5457F3ED",
      "name": "SCD_m1_us_110.bin",
      "label": "Model 1 v1.10",
      "requiredWhen": {
        "all": [
          {
            "setting": "systemHardware",
            "is": "genesis"
          },
          {
            "all": [
              {
                "slot": "cd"
              },
              {
                "any": [
                  {
                    "setting": "region",
                    "is": "autodetect"
                  },
                  {
                    "setting": "region",
                    "is": "usa"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cdBiosEU",
      "display": "Mega CD BIOS (Europe)",
      "description": "The boot ROM of the European Mega CD (128 KB).",
      "size": 131072,
      "sha1": "F891E0EA651E2232AF0C5C4CB46A0CAE2EE8F356",
      "name": "MCD_eu_100.bin",
      "label": "v1.00",
      "requiredWhen": {
        "all": [
          {
            "setting": "systemHardware",
            "is": "genesis"
          },
          {
            "all": [
              {
                "slot": "cd"
              },
              {
                "any": [
                  {
                    "setting": "region",
                    "is": "autodetect"
                  },
                  {
                    "setting": "region",
                    "is": "europe"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cdBiosJP",
      "display": "Mega CD BIOS (Japan)",
      "description": "The boot ROM of the Japanese Mega CD (128 KB).",
      "size": 131072,
      "sha1": "4846F448160059A7DA0215A5DF12CA160F26DD69",
      "name": "MCD_jp_100p.bin",
      "label": "v1.00p",
      "requiredWhen": {
        "all": [
          {
            "setting": "systemHardware",
            "is": "genesis"
          },
          {
            "all": [
              {
                "slot": "cd"
              },
              {
                "any": [
                  {
                    "setting": "region",
