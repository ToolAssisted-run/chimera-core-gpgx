  "settings": [
    {
      "name": "systemHardware",
      "display": "Console Hardware",
      "type": "enum",
      "options": [
        "genesis",
        "segacd",
        "sms",
        "gg",
        "sg"
      ],
      "default": "genesis",
      "description": "Which machine this project is. One core.wbx is a Mega Drive, a Sega CD, a Master System, a Game Gear or an SG-1000; this is the choice, pinned in the project and recorded in the movie - the emulator never guesses it from a file name. Sega CD is the one that takes discs; the rest take a cartridge of their own kind."
    },
    {
      "name": "port1",
      "display": "Control Type - Left Port",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "What is plugged into the console's left controller port. Some games expect a specific device. Only gamepads (and the multitaps' gamepads) are wired so far; the other devices land with the exotic-input milestone."
    },
    {
      "name": "port2",
      "display": "Control Type - Right Port",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "What is plugged into the console's right controller port."
    },
    {
      "name": "useSixButton",
      "display": "Use Six Button Controllers",
      "type": "bool",
      "default": false,
      "description": "Six button controllers instead of three button ones for any attached normal gamepad. Some games misbehave with six button controllers.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "region",
      "display": "Region",
      "type": "enum",
      "options": [
        "autodetect",
        "usa",
        "europe",
        "japanNtsc",
        "japanPal"
      ],
      "default": "autodetect",
      "description": "The emulated console's region. Many games run on several regions and behave differently across them; some require one."
    },
    {
      "name": "forceVDP",
      "display": "Force VDP Mode",
      "type": "enum",
      "options": [
        "disabled",
        "ntsc",
        "pal"
      ],
      "default": "disabled",
      "description": "Overrides the video mode to 60Hz (NTSC) or 50Hz (PAL) regardless of the console region."
    },
    {
      "name": "loadBios",
      "display": "Load BIOS",
      "type": "bool",
      "default": false,
      "description": "Boot through the system BIOS rom (the TMSS boot screen on a Genesis). Needs the matching firmware.",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "genesis",
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "overscan",
      "display": "Overscan",
      "type": "enum",
      "options": [
        "none",
        "vertical",
        "horizontal",
        "all"
      ],
      "default": "none",
      "description": "Which overscan borders are rendered."
    },
    {
      "name": "genesisFmSoundChip",
      "display": "Genesis FM Sound Chip",
      "type": "enum",
      "options": [
        "mameYM2612",
        "mameASICYM3438",
        "mameEnhancedYM3438",
        "nukedYM2612",
        "nukedYM3438"
      ],
      "default": "mameYM2612",
      "description": "How the Mega Drive/Genesis FM synthesizer is emulated. MAME options are fast; Nuked options are cycle accurate and expensive. YM2612 is the Model 1 chip, YM3438 later revisions.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "smsFmSoundChip",
      "display": "SMS FM Sound Chip",
      "type": "enum",
      "options": [
        "mame",
        "disabled",
        "nuked"
      ],
      "default": "mame",
      "description": "How the Mark III / Master System FM Sound Unit is emulated: MAME is fast, Nuked is cycle accurate and expensive, or no FM unit at all.",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "ggExtra",
      "display": "Game Gear Extended Screen",
      "type": "bool",
      "default": false,
      "description": "Shows the Game Gear's extended screen area (256x192).",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "gg"
      }
    },
    {
      "name": "filter",
      "display": "Audio Filter",
      "type": "enum",
      "options": [
        "lowPass",
        "none",
        "threeBand"
      ],
      "default": "lowPass",
      "description": "The audio output filter."
    },
    {
      "name": "lowPassRange",
      "display": "Low Pass Range",
      "type": "int",
      "default": 26214,
      "min": 0,
      "max": 65535,
      "description": "Low pass filter strength in 0.16 fixed point (26214 = 40%). Only active when the filter is lowPass."
    },
    {
      "name": "lowFreq",
      "display": "Three Band Low Cutoff",
      "type": "int",
      "default": 880,
      "description": "Only active when the filter is threeBand."
    },
    {
      "name": "highFreq",
      "display": "Three Band High Cutoff",
      "type": "int",
      "default": 5000,
      "description": "Only active when the filter is threeBand."
    },
    {
      "name": "lowGain",
      "display": "Three Band Low Gain",
      "type": "int",
      "default": 100,
      "description": "Percent. Only active when the filter is threeBand."
    },
    {
      "name": "midGain",
      "display": "Three Band Mid Gain",
      "type": "int",
      "default": 100,
      "description": "Percent. Only active when the filter is threeBand."
    },
    {
      "name": "highGain",
      "display": "Three Band High Gain",
      "type": "int",
      "default": 100,
      "description": "Percent. Only active when the filter is threeBand."
    },
    {
      "name": "spritesAlwaysOnTop",
      "display": "Sprites Always On Top",
      "type": "bool",
      "default": false,
      "description": "Forces sprites to display on top of everything.",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "forceSram",
      "display": "Force SRAM Mapping",
      "type": "bool",
      "default": false,
      "description": "Maps 64KB of battery SRAM at $200000 for cartridges smaller than 2MB whose header does not declare any. A few games need it (the author's BizHawk port fed this from its game database).",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    }
  ],
  "firmware": [
    {
      "id": "cdBiosUS",
      "display": "Sega CD BIOS (USA)",
      "description": "The USA Sega CD boot rom (128KB). Required to run a USA CD image; which console region a project uses is the region setting (autodetect keeps all three regions possible).",
      "size": 131072,
      "sha1": "F4F315ADCEF9B8FEB0364C21AB7F0EAF5457F3ED",
      "name": "SCD_m1_us_110.bin",
      "label": "Model 1 v1.10",
      "requiredWhen": {
        "all": [
          {
            "setting": "systemHardware",
            "is": "genesis"
          },
          {
            "all": [
              {
                "slot": "cd"
              },
              {
                "any": [
                  {
                    "setting": "region",
                    "is": "autodetect"
                  },
                  {
                    "setting": "region",
                    "is": "usa"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "cdBiosEU",
      "display": "Mega CD BIOS (Europe)",
