    {
      "id": "SMS",
      "label": "Master System",
      "when": [
        "sms"
      ],
      "input": {
        "name": "SMS Controller",
        "_comment": "index order is the wire format for this system's controller (the author's BizHawk definition): the console buttons, then its pads. The guest picks this wire from the machine it booted, so a package and its core always agree.",
        "buttons": [
          "Power",
          "Reset",
          "Pause",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P1 Button 1",
          "P1 Button 2",
          "P2 Up",
          "P2 Down",
          "P2 Left",
          "P2 Right",
          "P2 Button 1",
          "P2 Button 2"
        ],
        "mnemonics": {
          "Power": "P",
          "Reset": "r",
          "Pause": "p",
          "Up": "U",
          "Down": "D",
          "Left": "L",
          "Right": "R",
          "Button 1": "1",
          "Button 2": "2"
        }
      },
      "virtualWidth": 293,
      "virtualHeight": 192,
      "extensions": {
        ".sms": "SMS"
      },
      "settingOverrides": {
        "port1": {
          "options": [
            "gamepad",
            "none"
          ]
        },
        "port2": {
          "options": [
            "gamepad",
            "none"
          ]
        }
      }
    },
