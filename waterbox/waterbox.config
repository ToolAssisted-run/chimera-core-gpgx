                  },
                  {
                    "setting": "region",
                    "is": "japanNtsc"
                  },
                  {
                    "setting": "region",
                    "is": "japanPal"
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": "mdBios",
      "display": "Genesis TMSS Boot ROM",
      "description": "The Mega Drive / Genesis TMSS boot ROM (2 KB). It is asked for only when Load BIOS is on.",
      "size": 2048,
      "requiredWhen": {
        "all": [
          {
            "setting": "systemHardware",
            "is": "genesis"
          },
          {
            "setting": "loadBios",
            "is": true
          }
        ]
      }
    },
    {
      "id": "msBiosUS",
      "display": "Master System BIOS (USA)",
      "description": "The console's boot ROM. It is asked for only when Load BIOS is on.",
