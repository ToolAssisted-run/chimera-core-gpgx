{
  "coreName": "Genesis Plus GX",
  "author": "Eke-Eke (Genesis Plus GX); chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-gpgx",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    32,
    4,
    8,
    4,
    4
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. The core's state lives in the ELF's own sections (cart.rom is a 32MB static); the invisible heap carries only the 2MB render bitmap and the 1MB MCD saveram compose buffer.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame. Virtual dims are the NTSC 320x224 picture at its 292px aspect-corrected width.",
    "width": 1024,
    "height": 512,
    "virtualWidth": 292,
    "virtualHeight": 224,
    "vsyncNumerator": 53693175,
    "vsyncDenominator": 896040,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 2048,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "_machines_note": "ONE core.wbx, four machines. Genesis Plus GX is a Mega Drive, a Master System, a Game Gear and an SG-1000 - the same binary with different hardware selected - so this package is all four. What they share stays above; what makes them different machines is below. Which one a session is comes from the systemHardware setting, so a project pins it and a movie cites it.",
  "machineSetting": "systemHardware",
  "machines": [
    {
      "id": "GEN",
      "label": "Mega Drive / Genesis",
      "when": [
        "genesis"
      ],
      "input": {
        "name": "Genesis Controller",
        "_comment": "index order is the wire format: Power, Reset, Pause (the SMS/SG console button; inert on a Genesis), Previous/Next Disk (Sega CD swapping; the cd slot's list order is the swap order), then P1..P8 pads. Wider than 64, so everything rides the SetButton channel. Multitaps (teamplayer/wayplay) light up the higher players.",
        "buttons": [
          "Power",
          "Reset",
          "Pause",
          "Previous Disk",
          "Next Disk",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
