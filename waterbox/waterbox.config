    {
      "id": "PICO",
      "label": "Sega Pico",
      "when": [
        "pico"
      ],
      "virtualWidth": 292,
      "virtualHeight": 224,
      "input": {
        "name": "Pico Controller",
        "_comment": "index order is the wire format: Power, Reset, then the Pico's controls - its D-pad, the red button, the pen's button (the pen pressed on the drawing pad), and the storybook's page turns, which act when they go down and stop at the cover (page 0) and at page 7. The pen's place on the drawing pad is two axes, 0 to 65535 from one edge to the other.",
        "buttons": [
          "Power",
          "Reset",
          "P1 Up",
          "P1 Down",
          "P1 Left",
          "P1 Right",
          "P1 Red Button",
          "P1 Pen Button",
          "P1 Previous Page",
          "P1 Next Page"
        ],
        "mnemonics": {
          "Power": "P",
          "Reset": "r",
          "Up": "U",
          "Down": "D",
          "Left": "L",
          "Right": "R",
          "Red Button": "B",
          "Pen Button": "p",
          "Previous Page": "<",
          "Next Page": ">"
        },
        "axes": [
          {
            "name": "P1 Pen X",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "PenX"
          },
          {
            "name": "P1 Pen Y",
            "min": 0,
            "max": 65535,
            "neutral": 32768,
            "header": "PenY"
          }
        ]
      }
    }
  ],
  "settings": [
    {
      "name": "systemHardware",
      "display": "setting.systemhardware",
      "type": "enum",
      "options": [
        "genesis",
        "segacd",
        "sms",
        "gg",
        "sg",
        "pico"
      ],
      "default": "genesis",
      "description": "setting.systemhardware.about"
    },
    {
      "name": "port1",
      "display": "setting.port1",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "setting.port1.about",
      "exposedWhen": {
        "not": {
          "setting": "systemHardware",
          "is": "pico"
        }
      }
    },
    {
      "name": "port2",
      "display": "setting.port2",
      "type": "enum",
      "options": [
        "gamepad",
        "none",
        "mouse",
        "xea1p",
        "activator",
        "teamplayer",
        "wayplay",
        "paddle"
      ],
      "default": "gamepad",
      "description": "setting.port2.about",
      "exposedWhen": {
        "not": {
          "setting": "systemHardware",
          "is": "pico"
        }
      }
    },
    {
      "name": "useSixButton",
      "display": "setting.usesixbutton",
      "type": "bool",
      "default": false,
      "description": "setting.usesixbutton.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "region",
      "display": "setting.region",
      "type": "enum",
      "options": [
        "autodetect",
        "usa",
        "europe",
        "japanNtsc",
        "japanPal"
      ],
      "default": "autodetect",
      "description": "setting.region.about"
    },
    {
      "name": "forceVDP",
      "display": "setting.forcevdp",
      "type": "enum",
      "options": [
        "disabled",
        "ntsc",
        "pal"
      ],
      "default": "disabled",
      "description": "setting.forcevdp.about"
    },
    {
      "name": "loadBios",
      "display": "setting.loadbios",
      "type": "bool",
      "default": false,
      "description": "setting.loadbios.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "genesis",
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "overscan",
      "display": "setting.overscan",
      "type": "enum",
      "options": [
        "none",
        "vertical",
        "horizontal",
        "all"
      ],
      "default": "none",
      "description": "setting.overscan.about"
    },
    {
      "name": "genesisFmSoundChip",
      "display": "setting.genesisfmsoundchip",
      "type": "enum",
      "options": [
        "mameYM2612",
        "mameASICYM3438",
        "mameEnhancedYM3438",
        "nukedYM2612",
        "nukedYM3438"
      ],
      "default": "mameYM2612",
      "description": "setting.genesisfmsoundchip.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "smsFmSoundChip",
      "display": "setting.smsfmsoundchip",
      "type": "enum",
      "options": [
        "mame",
        "disabled",
        "nuked"
      ],
      "default": "mame",
      "description": "setting.smsfmsoundchip.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "in": [
          "sms",
          "gg"
        ]
      }
    },
    {
      "name": "ggExtra",
      "display": "setting.ggextra",
      "type": "bool",
      "default": false,
      "description": "setting.ggextra.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "gg"
      }
    },
    {
      "name": "filter",
      "display": "setting.filter",
      "type": "enum",
      "options": [
        "lowPass",
        "none",
        "threeBand"
      ],
      "default": "lowPass",
      "description": "setting.filter.about"
    },
    {
      "name": "lowPassRange",
      "display": "setting.lowpassrange",
      "type": "int",
      "default": 26214,
      "min": 0,
      "max": 65535,
      "description": "setting.lowpassrange.about"
    },
    {
      "name": "lowFreq",
      "display": "setting.lowfreq",
      "type": "int",
      "default": 880,
      "description": "common.used_only_when_audio_filter_is"
    },
    {
      "name": "highFreq",
      "display": "setting.highfreq",
      "type": "int",
      "default": 5000,
      "description": "common.used_only_when_audio_filter_is"
    },
    {
      "name": "lowGain",
      "display": "setting.lowgain",
      "type": "int",
      "default": 100,
      "description": "common.a_percentage_used_only_when"
    },
    {
      "name": "midGain",
      "display": "setting.midgain",
      "type": "int",
      "default": 100,
      "description": "common.a_percentage_used_only_when"
    },
    {
      "name": "highGain",
      "display": "setting.highgain",
      "type": "int",
      "default": 100,
      "description": "common.a_percentage_used_only_when"
    },
    {
      "name": "spritesAlwaysOnTop",
      "display": "setting.spritesalwaysontop",
      "type": "bool",
      "default": false,
      "description": "setting.spritesalwaysontop.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    },
    {
      "name": "forceSram",
      "display": "setting.forcesram",
      "type": "bool",
      "default": false,
      "description": "setting.forcesram.about",
      "exposedWhen": {
        "setting": "systemHardware",
        "is": "genesis"
      }
    }
  ],
  "firmware": [
    {
